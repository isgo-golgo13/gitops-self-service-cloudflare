# OpenTofu state in R2 via the S3 backend. One bucket for state, separate from app data.
# Native locking (use_lockfile) relies on R2 conditional writes; verify on first init.
bucket = "edge-factory-state"
key    = "control-plane/crossplane/terraform.tfstate"
region = "auto"

endpoints = {
  s3 = "https://CHANGEME_ACCOUNT_ID.r2.cloudflarestorage.com"
}

use_path_style = true
use_lockfile   = true

skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true
